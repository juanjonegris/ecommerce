{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "API_URL",
        "NODE_ENV",
        "STRIPE_SECRET_KEY",
        "RESEND_API_KEY",
        "MAILCHIMP_API_KEY",
        "KLAVIYO_API_KEY",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_BUCKET",
        "NEWSLETTER_PROVIDER",
        "SEARCH_PROVIDER",
        "SEARCH_FTS_LANGUAGE"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "PORT",
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "JWT_EXPIRES_IN",
        "JWT_REFRESH_SECRET",
        "JWT_REFRESH_EXPIRES_IN",
        "CORS_ORIGINS",
        "THROTTLE_TTL",
        "THROTTLE_LIMIT",
        "NODE_ENV",
        "API_URL",
        "STRIPE_SECRET_KEY",
        "RESEND_API_KEY",
        "MAILCHIMP_API_KEY",
        "KLAVIYO_API_KEY",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_BUCKET",
        "NEWSLETTER_PROVIDER",
        "SEARCH_PROVIDER",
        "SEARCH_FTS_LANGUAGE"
      ]
    }
  }
}
