NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://<user>:<password>@localhost:5433/<db>
REDIS_URL=redis://localhost:6380

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:3000

# Used by apps/web Server Components to fetch from the NestJS API
API_URL=http://localhost:3001

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Email (Resend). Leave RESEND_API_KEY empty in dev to log emails instead of sending.
RESEND_API_KEY=
MAIL_FROM=no-reply@localhost

# Payments (Stripe). Leave STRIPE_SECRET_KEY empty in dev to activate StubPaymentProvider
# (deterministic pi_stub_* / cs_stub_* ids; webhook accepts unsigned JSON with `stripe-signature: stub`).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Newsletter. NEWSLETTER_PROVIDER picks the adapter; an empty API key for the chosen
# provider falls back to StubNewsletterProvider (deterministic md5(email) ids, no network).
NEWSLETTER_PROVIDER=stub
NEWSLETTER_DOUBLE_OPT_IN=true
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_WEBHOOK_SECRET=
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=
KLAVIYO_WEBHOOK_SECRET=

# Storefront URL used to build click-through links in newsletter confirmation emails.
PUBLIC_WEB_URL=http://localhost:3000

# Object storage (S3 / MinIO). Empty access key → StubStorageProvider
# (no network; deterministic localhost-prefixed URLs for offline dev).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=<access-key>
S3_SECRET_KEY=<secret-key>
S3_BUCKET=<bucket-name>
S3_REGION=us-east-1
# Optional override for the public URL prefix (e.g. CloudFront, R2 custom domain).
S3_PUBLIC_URL=
# MinIO needs true; AWS S3 / R2 default to virtual-hosted style.
S3_FORCE_PATH_STYLE=true
# 5 MB cap; the DTO has a hard 25 MB defensive ceiling above this.
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIMES=image/jpeg,image/png,image/webp,image/avif
